# Supabase: Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias (can duplicate anon/service keys above)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# CRM login allowlist (your Supabase Auth user email)
CRM_ALLOWED_EMAILS=itssanramon.0@gmail.com

# Local dev only: skip CRM login (never true on production)
CRM_BYPASS_AUTH=true

# Public site URL used as a fallback for T-Bank return/webhook links
NEXT_PUBLIC_SITE_URL=https://rrclub.site

# Optional integrations (leave empty for local site + CRM testing)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TELEGRAM_BOT=
TELEGRAM_BOT_TOKEN=

# Admin email notifications (fiscal receipts go via T-Bank Receipt.Email, not SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
